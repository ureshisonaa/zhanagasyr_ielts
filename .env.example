# Development defaults. Export variables before starting Django.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# Production: DJANGO_DEBUG=0, a long random DJANGO_SECRET_KEY, real hosts and HTTPS.
DJANGO_SECRET_KEY=
CSRF_TRUSTED_ORIGINS=
# PostgreSQL example (supply credentials securely):
# DATABASE_URL=postgresql://user:password@db:5432/zhanagasyr
# PRIVATE_MEDIA_ROOT=/data/private
# TRUST_PROXY=1 only behind a trusted HTTPS reverse proxy.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
